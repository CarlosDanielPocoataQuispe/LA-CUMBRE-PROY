<%- include('partials/header', { titulo: t('admin') }) %>
<h1><%= t('admin') %></h1>
<nav class="pestanas"><% [['resumen','Resumen'],['pedidos','Pedidos'],['productos','Productos'],['envios','Distribución (envíos)'],['metales','Inventario de metales'],['diseno','Diseño del sitio']].forEach(s => { %><a href="/admin/<%= s[0] %>" class="<%= sec === s[0] ? 'on' : '' %>"><%= s[1] %></a><% }) %></nav>

<% if (sec === 'resumen') { %>
<div class="kpis">
  <div><b><%= r.pedidos %></b><span>Pedidos</span></div><div><b><%= bs(r.ventas) %></b><span>Ventas (sin cancelados)</span></div>
  <div><b><%= r.productos %></b><span>Productos activos</span></div><div><b><%= r.stock_bajo %></b><span>Con stock bajo (&lt; 10)</span></div><div><b><%= r.clientes %></b><span>Clientes</span></div>
</div>
<p class="nota">Desde las pestañas puedes cambiar estados de pedidos, agregar o quitar productos, gestionar los envíos, actualizar el stock de metales y cambiar el aspecto de la tienda.</p>
<% } %>

<% if (sec === 'pedidos') { %><div class="tabla-wrap"><table><tr><th>N°</th><th>Cliente</th><th>Destino</th><th>Pago</th><th>Total</th><th>Estado</th><th>Cambiar</th></tr>
<% pedidos.forEach(p => { %><tr><td><%= p.id_pedido %></td><td><%= p.cliente %></td><td><%= p.direccion_envio || (p.ciudad + ', ' + p.pais) %></td><td><%= p.metodo_pago %></td><td><%= bs(p.total) %></td><td><span class="estado"><%= p.estado %></span></td>
<td><form method="post" action="/admin/estado" class="fila"><input type="hidden" name="id_pedido" value="<%= p.id_pedido %>"><select name="estado"><% estados.forEach(e => { %><option <%= e === p.estado ? 'selected' : '' %>><%= e %></option><% }) %></select><input name="transportista" placeholder="Transportista (si es Enviado)"><button class="btn peq">Guardar</button></form></td></tr><% }) %></table></div><% } %>

<% if (sec === 'productos') { %>
<form method="post" action="/admin/producto" class="form panel">
  <h2><%= edit ? 'Editar producto' : 'Agregar producto' %></h2>
  <% if (edit) { %><input type="hidden" name="id_producto" value="<%= edit.id_producto %>"><% } %>
  <label>Nombre <input name="nombre" value="<%= edit ? edit.nombre : '' %>" required></label>
  <label>Categoría <input name="categoria" value="<%= edit ? edit.categoria : '' %>" required></label>
  <div class="fila"><label>Precio (Bs) <input type="number" step="0.01" name="precio" value="<%= edit ? edit.precio : '' %>" required></label><label>Stock <input type="number" name="stock" value="<%= edit ? edit.stock : '' %>" required></label></div>
  <label>Imagen (nombre del archivo en public/img o una dirección https) <input name="imagen" value="<%= edit ? edit.imagen : '' %>"></label>
  <label>Material <input name="material" value="<%= edit ? edit.material : 'Estaño' %>"></label>
  <label>Medidas <input name="medidas" value="<%= edit ? (edit.medidas || '') : '' %>"></label>
  <label>Descripción <textarea name="descripcion" rows="3"><%= edit ? edit.descripcion : '' %></textarea></label>
  <div class="fila"><button class="btn">Guardar</button><% if (edit) { %><a class="btn claro" href="/admin/productos">Cancelar</a><% } %></div>
</form>
<div class="tabla-wrap"><table><tr><th></th><th>Producto</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Visible</th><th></th></tr>
<% productos.forEach(p => { %><tr class="<%= p.activo ? '' : 'oculto' %>"><td><img class="mini" src="<%= img(p.imagen) %>" alt="" onerror="this.onerror=null;this.src='/img/sin-imagen.svg'"></td><td><%= p.nombre %></td><td><%= p.categoria %></td><td><%= bs(p.precio) %></td><td><%= p.stock %></td><td><%= p.activo ? 'Sí' : 'No' %></td>
<td class="fila"><a class="btn claro peq" href="/admin/productos?editar=<%= p.id_producto %>">Editar</a>
<form method="post" action="/admin/producto/visibilidad"><input type="hidden" name="id_producto" value="<%= p.id_producto %>"><button class="btn claro peq"><%= p.activo ? 'Quitar' : 'Mostrar' %></button></form></td></tr><% }) %></table></div><% } %>

<% if (sec === 'envios') { %><p class="nota">Los envíos se crean automáticamente al marcar un pedido como "Enviado".</p>
<div class="tabla-wrap"><table><tr><th>N°</th><th>Pedido</th><th>Cliente</th><th>Destino</th><th>Transportista, código y estado</th></tr>
<% envios.forEach(e => { %><tr><td><%= e.id_envio %></td><td><%= e.id_pedido %></td><td><%= e.cliente %></td><td><%= e.destino %></td>
<td><form method="post" action="/admin/envio" class="fila"><input type="hidden" name="id_envio" value="<%= e.id_envio %>"><input name="transportista" value="<%= e.transportista %>"><input name="cod_seguimiento" value="<%= e.cod_seguimiento %>"><select name="estado"><% estadosEnvio.forEach(s => { %><option <%= s === e.estado ? 'selected' : '' %>><%= s %></option><% }) %></select><button class="btn peq">Guardar</button></form></td></tr><% }) %></table></div>
<% if (!envios.length) { %><p class="vacio">Aún no hay envíos.</p><% } %><% } %>

<% if (sec === 'metales') { %><div class="tabla-wrap"><table><tr><th>Metal</th><th>Stock (kg)</th><th>Costo por kg (Bs)</th><th></th></tr>
<% metales.forEach(m => { %><tr><form method="post" action="/admin/metal"><td><%= m.nombre %><input type="hidden" name="id_metal" value="<%= m.id_metal %>"></td><td><input type="number" step="0.01" name="stock_kg" value="<%= m.stock_kg %>"></td><td><input type="number" step="0.01" name="costo_kg" value="<%= m.costo_kg %>"></td><td><button class="btn peq">Guardar</button></td></form></tr><% }) %></table></div><% } %>

<% if (sec === 'diseno') { %>
<form method="post" action="/admin/diseno" class="form panel">
  <label>Nombre de la tienda <input name="nombre_tienda" value="<%= cfg.nombre_tienda %>"></label>
  <label>Eslogan <input name="eslogan" value="<%= cfg.eslogan %>"></label>
  <label>Título del banner <input name="banner_titulo" value="<%= cfg.banner_titulo %>"></label>
  <label>Texto del banner <textarea name="banner_texto" rows="3"><%= cfg.banner_texto %></textarea></label>
  <label>Color principal <input type="color" name="color_principal" value="<%= cfg.color_principal %>"></label>
  <label>Dirección <input name="direccion" value="<%= cfg.direccion %>"></label>
  <label>Facebook (dirección) <input name="facebook" value="<%= cfg.facebook %>"></label>
  <label>Horario de atención <input name="horario" value="<%= cfg.horario %>"></label>
  <label>Entregas <input name="entregas" value="<%= cfg.entregas %>"></label>
  <label>Países y zonas de envío <input name="paises_envio" value="<%= cfg.paises_envio %>"></label>
  <label>Materia prima <input name="materia_prima" value="<%= cfg.materia_prima %>"></label>
  <label>Mínimo de piezas por pedido (venta por mayor) <input type="number" min="1" name="minimo_mayor" value="<%= cfg.minimo_mayor %>"></label>
  <button class="btn">Guardar diseño</button>
</form><% } %>
<%- include('partials/footer') %>
