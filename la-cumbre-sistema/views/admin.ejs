<%- include('partials/header') %>
<h1>Administración</h1>
<% if (mensaje) { %><p class="aviso"><%= mensaje %></p><% } %>

<h2>Pedidos</h2>
<table><tr><th>N°</th><th>Cliente</th><th>Destino</th><th>Total</th><th>Estado</th><th>Cambiar</th></tr>
<% pedidos.forEach(p => { %>
  <tr><td><%= p.id_pedido %></td><td><%= p.cliente %></td><td><%= p.ciudad %>, <%= p.pais %></td><td><%= p.total %></td><td><%= p.estado %></td>
  <td><form method="post" action="/admin/estado" class="fila">
    <input type="hidden" name="id_pedido" value="<%= p.id_pedido %>">
    <select name="estado"><% estados.forEach(e => { %><option <%= e === p.estado ? 'selected' : '' %>><%= e %></option><% }) %></select>
    <input name="transportista" placeholder="Transportista">
    <button>Guardar</button></form></td></tr>
<% }) %>
</table>

<h2>Productos</h2>
<table><tr><th>Nombre</th><th>Categoría</th><th>Precio</th><th>Stock</th><th>Imagen</th></tr>
<% productos.forEach(p => { %><tr><td><%= p.nombre %></td><td><%= p.categoria %></td><td><%= p.precio %></td><td><%= p.stock %></td><td><%= p.imagen %></td></tr><% }) %>
</table>
<form method="post" action="/admin/producto" class="fila">
  <input name="nombre" placeholder="Nombre" required><input name="categoria" placeholder="Categoría">
  <input type="number" step="0.01" name="precio" placeholder="Precio" required><input type="number" name="stock" placeholder="Stock" required>
  <input name="imagen" placeholder="archivo.jpg (en public/img)"><button>Agregar producto</button>
</form>

<h2>Inventario de metales</h2>
<table><tr><th>Metal</th><th>Stock (kg)</th><th>Costo por kg (Bs)</th></tr>
<% metales.forEach(m => { %><tr><td><%= m.nombre %></td><td><%= m.stock_kg %></td><td><%= m.costo_kg %></td></tr><% }) %>
</table>
<%- include('partials/footer') %>
