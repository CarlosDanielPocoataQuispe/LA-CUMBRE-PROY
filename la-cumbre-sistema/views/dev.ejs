<%- include('partials/header') %>
<h1>Panel del desarrollador</h1>
<% if (mensaje) { %><p class="aviso"><%= mensaje %></p><% } %>
<p>Conexión con la base de datos: correcta. Hora del servidor de base de datos: <%= new Date(hora).toLocaleString('es-BO') %></p>
<h2>Usuarios y roles</h2>
<table><tr><th>N°</th><th>Nombre</th><th>Correo</th><th>Rol</th></tr>
<% usuarios.forEach(u => { %>
  <tr><td><%= u.id_usuario %></td><td><%= u.nombre %></td><td><%= u.email %></td>
  <td><form method="post" action="/dev/rol" class="fila">
    <input type="hidden" name="id_usuario" value="<%= u.id_usuario %>">
    <select name="id_rol"><% roles.forEach(r => { %><option value="<%= r.id_rol %>" <%= r.id_rol === u.id_rol ? 'selected' : '' %>><%= r.nombre %></option><% }) %></select>
    <button>Guardar</button></form></td></tr>
<% }) %>
</table>
<%- include('partials/footer') %>
