<%- include('partials/header', { titulo: t('registro') }) %>
<section class="panel estrecho"><h1><%= t('registro') %></h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/registro" class="form">
  <label>Nombre completo <input name="nombre" required></label>
  <label>Correo <input type="email" name="email" required></label>
  <label>Clave (mínimo 6) <input type="password" name="password" required></label>
  <label>Teléfono <input name="telefono"></label>
  <label>País <input name="pais" value="Bolivia"></label>
  <label>Departamento / ciudad <input name="ciudad"></label>
  <button class="btn"><%= t('registro') %></button>
</form></section>
<%- include('partials/footer') %>
